{
  "uid": "security-vision",
  "title": "Security Vision",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "security-vision"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Análisis por segundo y cámara",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sv_analysis_frames_total[1m])",
          "legendFormat": "{{camera}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latencia de extremo a extremo (captura → resultado)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sv_stage_ms{stage=\"end_to_end\",quantile=\"0.5\"}",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "sv_stage_ms{stage=\"end_to_end\",quantile=\"0.95\"}",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tiempos por etapa (p50)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sv_stage_ms{quantile=\"0.5\",stage!=\"end_to_end\",stage!=\"batch_size\"}",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cámaras en línea",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sv_camera_up)",
          "legendFormat": "en línea"
        },
        {
          "refId": "B",
          "expr": "count(sv_camera_up)",
          "legendFormat": "configuradas"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU: uso y estado de energía",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sv_gpu_utilization_percent",
          "legendFormat": "uso %"
        },
        {
          "refId": "B",
          "expr": "sv_gpu_pstate",
          "legendFormat": "P-state"
        },
        {
          "refId": "C",
          "expr": "sv_gpu_temperature_celsius",
          "legendFormat": "°C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU y memoria del worker",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sv_worker_cpu_percent",
          "legendFormat": "CPU %"
        },
        {
          "refId": "B",
          "expr": "sv_worker_memory_rss_bytes / 1e9",
          "legendFormat": "RSS GB"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Incumplimientos confirmados por minuto",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ppe) (rate(sv_violations_confirmed_total[5m])) * 60",
          "legendFormat": "{{ppe}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "API: peticiones por segundo por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(sv_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
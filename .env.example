# Copiar a .env y completar. NUNCA versionar .env.
# Secretos: uv run svctl gen-secrets

SV_ENVIRONMENT=development          # development | test | production
SV_LOG_LEVEL=INFO
SV_LOG_JSON=true

# Base de datos (sin Docker: la rellena scripts/dev_postgres.py init)
SV_DATABASE_URL=postgresql+asyncpg://security_vision:<password>@127.0.0.1:5433/security_vision
SV_TEST_DATABASE_URL=postgresql+asyncpg://security_vision:<password>@127.0.0.1:5433/security_vision_test
SV_DB_PASSWORD=<solo para docker-compose>

SV_JWT_SECRET=<al menos 32 caracteres aleatorios>
SV_SECRETS_KEY=<32 bytes en base64 url-safe>
SV_ACCESS_TOKEN_MINUTES=15
SV_REFRESH_TOKEN_DAYS=7
SV_MAX_FAILED_LOGINS=5
SV_LOCKOUT_MINUTES=15
SV_CORS_ORIGINS=["http://localhost:5173"]

# --- Rendimiento y observabilidad (Fase 9) ---
# Micro-batching de la detección: lote máximo y espera opcional para completarlo (0 = sin espera)
# SV_DETECTION_MAX_BATCH=4
# SV_DETECTION_MAX_WAIT_MS=0
# Trazas OpenTelemetry (OTLP/HTTP). Vacío = desactivadas (coste nulo)
# SV_OTEL_ENDPOINT=http://127.0.0.1:4318
# SV_OTEL_SAMPLE_RATIO=0.1

# --- Alertas externas (Fase 8) ---
# URL pública de la web: los avisos incluyen un enlace al incidente (vacío = sin enlace)
# SV_PUBLIC_WEB_URL=https://seguridad.ejemplo.com
# SV_ALERTS_ENABLED=true
# Webhooks hacia la red privada/local (riesgo SSRF): solo si el receptor está en la LAN
# SV_ALERT_WEBHOOK_ALLOW_PRIVATE=false
# Correo por SMTP propio (vacío = canal email no disponible). smtp_security: starttls | ssl | none
# SV_SMTP_HOST=smtp.ejemplo.com
# SV_SMTP_PORT=587
# SV_SMTP_SECURITY=starttls
# SV_SMTP_USER=alertas@ejemplo.com
# SV_SMTP_PASSWORD=
# SV_SMTP_FROM=Security Vision <alertas@ejemplo.com>

# Primer administrador (solo se usa si no existe ningún usuario)
SV_BOOTSTRAP_ADMIN_EMAIL=admin@example.local
SV_BOOTSTRAP_ADMIN_PASSWORD=<mínimo 12 caracteres, 3 tipos>

SV_GRAFANA_ADMIN_PASSWORD=<solo perfil monitoring>
